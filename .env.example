# Copy to `.env` for `docker compose up`. See README.md.

# Browser-reachable signaling WebSocket (web image build arg; not a docker-internal hostname).
VITE_SIGNALING_URL=ws://localhost:8080

# Optional Cloudflare Calls TURN (signaling server only; see README).
# TURN_API_TOKEN=
# TURN_KEY_ID=

# Optional comma-separated browser origins for signaling + /ice-servers.
# ALLOWED_ORIGINS=https://play.example.com

# --- Ops dashboard (compose service; expose via your reverse proxy / Coolify domain) ---
# Protect the ops UI with reverse-proxy auth, but exempt from that auth:
#   OPTIONS /api/events  (CORS preflight from play origin)
#   POST    /api/events  (ingest; authorized by x-analytics-key or ?key=, not your proxy login)
# Keep GET / and GET /api/overview behind auth (ops UI only).
# Shared secret for signaling stats, ingest API, and browser beacons (visible in web bundle).
# DASHBOARD_API_KEY=change-me-in-production
# VITE_ANALYTICS_URL=http://localhost:9090
# DASHBOARD_ALLOWED_ORIGINS=https://play.example.com
