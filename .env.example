# Used by docker-compose.yml when building the web image.
# Must be an address the PLAYERS' BROWSERS can reach, not a docker-internal hostname.
VITE_SIGNALING_URL=ws://localhost:8080

# Optional JSON array of ICE servers (STUN + TURN). When set, replaces built-in Google STUN defaults.
# Rebuild the web image after changing (docker compose build web).
#
# Cloudflare Realtime TURN — https://developers.cloudflare.com/realtime/turn/generate-credentials/
#   STUN over UDP:  stun.cloudflare.com:3478
#   TURN over UDP:  turn.cloudflare.com:3478
#   TURN over TCP:  turn.cloudflare.com:3478
#   TURN over TLS:  turn.cloudflare.com:5349
# TURN username/credential are short-lived — generate via the Cloudflare API; do not commit real secrets.
#
# VITE_ICE_SERVERS=[{"urls":"stun:stun.cloudflare.com:3478"},{"urls":["turn:turn.cloudflare.com:3478?transport=udp","turn:turn.cloudflare.com:3478?transport=tcp","turns:turn.cloudflare.com:5349?transport=tcp"],"username":"YOUR_USERNAME","credential":"YOUR_CREDENTIAL"}]
#
# STUN only (no TURN key yet):
# VITE_ICE_SERVERS=[{"urls":"stun:stun.cloudflare.com:3478"}]
