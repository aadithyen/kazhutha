# Used by docker-compose.yml when building the web image.
# Must be an address the PLAYERS' BROWSERS can reach, not a docker-internal hostname.
VITE_SIGNALING_URL=ws://localhost:8080

# VITE_APP_VERSION=0.1.0

# Optional Cloudflare Calls TURN key (for strict NATs). The SIGNALING server uses
# these to generate short-lived ICE credentials at GET /ice-servers; the browser
# fetches them from there, so the API token never reaches the frontend.
# TURN_API_TOKEN=your-cloudflare-turn-api-token
# TURN_KEY_ID=your-cloudflare-turn-key-id
# TURN_CREDENTIAL_TTL=86400

# --- Signaling logs (stdout JSON) ---
# TELEMETRY_ENABLED=true
# LOG_LEVEL=info
# ENVIRONMENT=development
# APP_VERSION=0.1.0
# OTEL_SERVICE_NAME=kazhutha-signaling
# Salt for hashing client IPs in security events (change in production).
# TELEMETRY_IP_HASH_SALT=change-me-in-production

# --- Host ports (for reverse-proxy to separate domains) ---
# WEB_PORT=3000
# SIGNALING_PORT=8080
# DASHBOARD_PORT=9090

# --- Ops dashboard (separate compose service from the game UI) ---
# Game UI: web container (WEB_PORT). Ops UI + ingest API: dashboard (DASHBOARD_PORT).
# Example: play.example.com → web, ops.example.com → dashboard (auth on ops only).
# Browsers POST client events to VITE_ANALYTICS_URL; if ops domain is fully behind
# proxy auth, exempt POST /api/events or use a dedicated ingest hostname.
# Shared secret for signaling stats, ingest API, and browser beacons (visible in web bundle).
# DASHBOARD_API_KEY=change-me-in-production
# Public URLs (browser-reachable, not docker-internal hostnames):
# VITE_SIGNALING_URL=wss://signal.example.com
# VITE_ANALYTICS_URL=https://ops.example.com
# DASHBOARD_INGEST_URL=http://dashboard:9090
# DASHBOARD_ALLOWED_ORIGINS=https://play.example.com
