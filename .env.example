# Used by docker-compose.yml when building the web image.
# Must be an address the PLAYERS' BROWSERS can reach, not a docker-internal hostname.
VITE_SIGNALING_URL=ws://localhost:8080

# JSON array of ICE servers (STUN + TURN). No built-in defaults — set this for real deployments.
# Include at least one STUN and one TURN URL. Rebuild the web image after changing.
#
# Example (self-hosted coturn or any TURN provider):
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"},{"urls":"turn:turn.example.com:3478?transport=tcp","username":"user","credential":"pass"}]
