# Used by docker-compose.yml when building the web image.
# Must be an address the PLAYERS' BROWSERS can reach, not a docker-internal hostname.
VITE_SIGNALING_URL=ws://localhost:8080

# Optional JSON array of extra ICE servers merged with the built-in Google STUN servers.
# Required for many real-world networks — STUN alone often fails across strict NATs/firewalls.
# Example with coturn or another TURN provider:
# VITE_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
