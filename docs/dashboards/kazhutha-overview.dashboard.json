        {
          "id": "Panel_http_req_rate",
          "type": "line",
          "title": "HTTP Request Rate",
          "description": "Requests per second from OTLP counter http_requests_total",
          "config": { "show_legends": true, "unit": "reqps", "decimals": 2 },
          "queryType": "promql",
          "queries": [
            {
              "query": "sum(rate(http_requests_total[5m]))",
              "customQuery": true,
              "fields": {
                "stream": "http_requests_total",
                "stream_type": "metrics",
                "x": [],
                "y": [],
                "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] }
              },
              "config": { "promql_legend": "total" }
            }
          ],
          "layout": { "x": 0, "y": 7, "w": 12, "h": 8, "i": 4 }
        },
        {
          "id": "Panel_http_5xx_rate",
          "type": "line",
          "title": "HTTP 5xx Rate",
          "description": "Server errors per second — primary downtime signal",
          "config": { "show_legends": true, "unit": "reqps", "decimals": 3 },
          "queryType": "promql",
          "queries": [
            {
              "query": "sum(rate(http_server_errors_total[5m]))",
              "customQuery": true,
              "fields": {
                "stream": "http_server_errors_total",
                "stream_type": "metrics",
                "x": [],
                "y": [],
                "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] }
              },
              "config": { "promql_legend": "5xx" }
            }
          ],
          "layout": { "x": 12, "y": 7, "w": 12, "h": 8, "i": 5 }
        },
        {
          "id": "Panel_http_latency_logs",
          "type": "line",
          "title": "HTTP Latency (avg ms, logs)",
          "description": "Average duration_ms from application_logs HTTP requests",
          "config": { "show_legends": true, "unit": "milliseconds", "decimals": 0 },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS x_axis_1, avg(duration_ms) AS y_axis_1 FROM \"application_logs\" WHERE message = 'HTTP request' GROUP BY x_axis_1 ORDER BY x_axis_1",
              "customQuery": true,
              "fields": {
                "stream": "application_logs",
                "stream_type": "logs",
                "x": [{ "label": "Time", "alias": "x_axis_1", "column": "_timestamp" }],
                "y": [{ "label": "Avg ms", "alias": "y_axis_1", "column": "duration_ms", "aggregationFunction": "avg" }],
                "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] }
              },
              "config": {}
            }
          ],
          "layout": { "x": 0, "y": 15, "w": 12, "h": 8, "i": 6 }
        },
        {
          "id": "Panel_http_latency_by_route",
          "type": "table",
          "title": "HTTP Latency by Route",
          "description": "avg / max duration_ms per route",
          "config": { "show_legends": false, "wrap_table_cells": true },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT route, avg(duration_ms) AS avg_ms, max(duration_ms) AS max_ms, count(*) AS requests FROM \"application_logs\" WHERE message = 'HTTP request' GROUP BY route ORDER BY avg_ms DESC",
              "customQuery": true,
              "fields": {
                "stream": "application_logs",
                "stream_type": "logs",
                "x": [],
                "y": [],
                "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] }
              },
              "config": {}
            }
          ],
          "layout": { "x": 12, "y": 15, "w": 12, "h": 8, "i": 7 }
        },
        {
          "id": "Panel_player_joins",
          "type": "bar",
          "title": "Player Joins",
          "description": "Join events from application_logs",
          "config": { "show_legends": false, "unit": "numbers", "decimals": 0 },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS x_axis_1, count(*) AS y_axis_1 FROM \"application_logs\" WHERE message = 'Player joined room' GROUP BY x_axis_1 ORDER BY x_axis_1",
              "customQuery": true,
              "fields": {
                "stream": "application_logs",
                "stream_type": "logs",
                "x": [{ "label": "Time", "alias": "x_axis_1", "column": "_timestamp" }],
                "y": [{ "label": "Joins", "alias": "y_axis_1", "column": "_timestamp", "aggregationFunction": "count" }],
                "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] }
              },
              "config": {}
            }
          ],
          "layout": { "x": 0, "y": 23, "w": 12, "h": 8, "i": 8 }
        },
        {
          "id": "Panel_server_errors_logs",
          "type": "bar",
          "title": "Server Errors (logs)",
          "description": "level=error or status_code >= 500",
          "config": { "show_legends": false, "unit": "numbers", "decimals": 0 },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp) AS x_axis_1, count(*) AS y_axis_1 FROM \"application_logs\" WHERE level = 'error' OR status_code >= 500 GROUP BY x_axis_1 ORDER BY x_axis_1",
              "customQuery": true,
              "fields": {
                "stream": "application_logs",
                "stream_type": "logs",
                "x": [{ "label": "Time", "alias": "x_axis_1", "column": "_timestamp" }],
                "y": [{ "label": "Errors", "alias": "y_axis_1", "column": "_timestamp", "aggregationFunction": "count" }],
                "filter": { "filterType": "group", "logicalOperator": "AND", "conditions": [] }
              },
              "config": {}
            }
          ],
          "layout": { "x": 12, "y": 23, "w": 12, "h": 8, "i": 9 }
